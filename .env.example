# Safe default: synthetic demo data only. Copy this file to .env.
CRM_DATA_MODE=demo
PORT=3001
# CRM_DEMO_FILE=.local/crm-demo.json

# Select postgres only after the dedicated yeta_crm schema has been reviewed/applied.
# Missing schema or failed connection stops startup. No automatic migration/fallback.
# CRM_DATA_MODE=postgres
# CRM_DATABASE=yeta_crm
# DB_INFO_FILE=.local/db-info.properties
# Alternatively set DATABASE_URL in your private environment (never commit credentials).
# DATABASE_URL takes priority over DB_INFO_FILE and CRM_DATABASE, including the target DB name.
# DB_INFO_FILE must be set explicitly when DATABASE_URL is absent.
# The API binds 127.0.0.1 only. Production startup stays blocked pending deployment configuration.
